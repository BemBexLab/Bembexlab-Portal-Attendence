NODE_ENV=production
PORT=4000
API_URL="http://localhost:4000"
CORS_ORIGIN="https://your-domain.com"
COOKIE_SECURE=true

SUPABASE_URL="https://your-project-ref.supabase.co"
SUPABASE_PUBLISHABLE_KEY="sb_publishable_your_publishable_key"
SUPABASE_SECRET_KEY="sb_secret_your_server_only_secret_key"
SUPABASE_JWKS_URL="https://your-project-ref.supabase.co/auth/v1/.well-known/jwks.json"

DATABASE_URL="postgresql://postgres.your-project-ref:your-database-password@aws-0-your-region.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1&sslmode=no-verify"
DIRECT_URL="postgresql://postgres:your-database-password@db.your-project-ref.supabase.co:5432/postgres"

REDIS_URL="redis://default:your-password@your-redis-host:6379"
REDIS_HOST=
REDIS_PORT=

JWT_SECRET="replace-with-a-long-random-production-secret"

ATTENDANCE_SYNC_ENABLED=true
ATTENDANCE_SYNC_EVERY_MS=300000
ATTENDANCE_DEFAULT_TIMEZONE=Asia/Karachi
ZKTECO_TIMEOUT_MS=10000
ZKTECO_LOCAL_PORT=0
ZKTECO_TIME_OFFSET_MINUTES=0
ZKTECO_DEVICE_UTC_OFFSET_MINUTES=300
ZKTECO_PROTOCOL=auto

SEED_ORGANIZATION_NAME="Bembex"
SEED_ADMIN_NAME="Organization Admin"
SEED_ADMIN_EMAIL="admin@example.com"
SEED_ADMIN_PASSWORD="replace-before-production"
SEED_EMPLOYEE_CODE="EMP-001"
SEED_EMPLOYEE_NAME="Sample Employee"
SEED_EMPLOYEE_DEVICE_USER_ID="1"
SEED_DEVICE_NAME="K40 Main Gate"
SEED_DEVICE_IP="192.168.10.197"
SEED_DEVICE_PORT=4370
