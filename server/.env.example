# Supabase is not used. All application data is stored in VPS PostgreSQL.
# SUPABASE_URL=
# SUPABASE_PUBLISHABLE_KEY=
# SUPABASE_SECRET_KEY=
# SUPABASE_JWKS_URL=

# Runtime Prisma connection: VPS PostgreSQL.
DATABASE_URL="postgresql://appdbuser:your-database-password@your-vps-host:5432/appdb?sslmode=require"

# Migration Prisma connection: VPS PostgreSQL direct connection.
DIRECT_URL="postgresql://appdbuser:your-database-password@your-vps-host:5432/appdb?sslmode=require"

# Use either REDIS_URL or REDIS_HOST/REDIS_PORT.
REDIS_URL=
REDIS_HOST=
REDIS_PORT=

JWT_SECRET=

PORT=
CORS_ORIGIN="https://your-domain.com"
COOKIE_SECURE=true
NODE_ENV=production

ATTENDANCE_SYNC_ENABLED=true
ATTENDANCE_SYNC_EVERY_MS=300000
ATTENDANCE_DEFAULT_TIMEZONE=Asia/Karachi
ZKTECO_TIMEOUT_MS=10000
ZKTECO_LOCAL_PORT=0
ZKTECO_TIME_OFFSET_MINUTES=0
ZKTECO_DEVICE_UTC_OFFSET_MINUTES=300
ZKTECO_PROTOCOL=auto

SEED_ORGANIZATION_NAME="Bembex Demo Organization"
SEED_ADMIN_NAME="Organization Admin"
SEED_ADMIN_EMAIL="admin@bembexlab.com"
SEED_ADMIN_PASSWORD="Admin-123"
SEED_EMPLOYEE_CODE="EMP-001"
SEED_EMPLOYEE_NAME="Sample Employee"
SEED_EMPLOYEE_DEVICE_USER_ID="1"
SEED_DEVICE_NAME="K40 Main Gate"
SEED_DEVICE_IP="192.168.10.197"
SEED_DEVICE_PORT=4370
