SUPABASE_URL="https://your-project-ref.supabase.co"
SUPABASE_PUBLISHABLE_KEY="sb_publishable_your_publishable_key"
SUPABASE_SECRET_KEY="sb_secret_your_server_only_secret_key"
SUPABASE_JWKS_URL="https://your-project-ref.supabase.co/auth/v1/.well-known/jwks.json"

# Runtime Prisma connection: use Supabase Transaction Pooler.
DATABASE_URL="postgresql://postgres.your-project-ref:your-database-password@aws-0-your-region.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1"

# Migration Prisma connection: use Supabase Direct Connection.
DIRECT_URL="postgresql://postgres:your-database-password@db.your-project-ref.supabase.co:5432/postgres"

# Use either REDIS_URL or REDIS_HOST/REDIS_PORT.
REDIS_URL=
REDIS_HOST=
REDIS_PORT=

JWT_SECRET=

PORT=
CORS_ORIGIN="https://your-domain.com"
COOKIE_SECURE=true
NODE_ENV=production

ATTENDANCE_SYNC_ENABLED=true
ATTENDANCE_SYNC_EVERY_MS=300000
ATTENDANCE_DEFAULT_TIMEZONE=Asia/Karachi
ZKTECO_TIMEOUT_MS=10000
ZKTECO_LOCAL_PORT=0
ZKTECO_TIME_OFFSET_MINUTES=0
ZKTECO_DEVICE_UTC_OFFSET_MINUTES=300
ZKTECO_PROTOCOL=auto

SEED_ORGANIZATION_NAME="Bembex Demo Organization"
SEED_ADMIN_NAME="Organization Admin"
SEED_ADMIN_EMAIL="admin@bembexlab.com"
SEED_ADMIN_PASSWORD="Admin-123"
SEED_EMPLOYEE_CODE="EMP-001"
SEED_EMPLOYEE_NAME="Sample Employee"
SEED_EMPLOYEE_DEVICE_USER_ID="1"
SEED_DEVICE_NAME="K40 Main Gate"
SEED_DEVICE_IP="192.168.10.197"
SEED_DEVICE_PORT=4370
