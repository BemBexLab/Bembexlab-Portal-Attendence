# Supabase is not used. All application data is stored in VPS PostgreSQL.
# SUPABASE_URL=
# SUPABASE_PUBLISHABLE_KEY=
# SUPABASE_SECRET_KEY=
# SUPABASE_JWKS_URL=

# Runtime Prisma connection: VPS PostgreSQL.
DATABASE_URL="postgresql://appdbuser:your-database-password@your-vps-host:56982/appdb?sslmode=no-verify"

# Migration Prisma connection: VPS PostgreSQL direct connection.
DIRECT_URL="postgresql://appdbuser:your-database-password@your-vps-host:56982/appdb?sslmode=no-verify"

JWT_SECRET=

PORT=
CORS_ORIGIN="https://your-domain.com"
COOKIE_SECURE=true
NODE_ENV=production

ATTENDANCE_DEFAULT_TIMEZONE=Asia/Karachi
