generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  SUPER_ADMIN
  ORG_ADMIN
  HR_MANAGER
  EMPLOYEE
}

enum DeviceStatus {
  ACTIVE
  INACTIVE
  OFFLINE
  MAINTENANCE
}

enum VerificationType {
  FINGERPRINT
  PASSWORD
  CARD
  FACE
  MANUAL
  UNKNOWN
}

enum AttendanceStatus {
  PRESENT
  ABSENT
  LATE
  HALF_DAY
  MISSING_CHECKOUT
  ON_LEAVE
  HOLIDAY
  REMOTE
}

enum RequestKind {
  LEAVE
  REMOTE_WORK
  CORRECTION
}

enum LeaveCategory {
  ANNUAL_LEAVE
  SICK_LEAVE
  CASUAL_LEAVE
  UNPAID_LEAVE
}

enum RequestStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
}

enum ComplaintType {
  INCORRECT_CHECK_IN
  INCORRECT_CHECK_OUT
  INCORRECT_STATUS
  MISSING_ATTENDANCE
  OTHER
}

enum CorrectionStatus {
  PENDING
  APPROVED
  REJECTED
}

model Organization {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name      String   @db.VarChar(160)
  timezone  String   @default("UTC") @db.VarChar(80)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  users                 User[]
  departments           Department[]
  employees             Employee[]
  zktecoDevices         ZktecoDevice[]
  attendanceLogs        AttendanceLog[]
  dailyAttendances      DailyAttendance[]
  shifts                Shift[]
  employeeRequests      EmployeeRequest[]
  attendanceCorrections AttendanceCorrection[]
  deductions Deduction[]

  @@index([name])
  @@map("organizations")
}

model User {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String?  @map("organization_id") @db.Uuid
  employeeId     String?  @unique @map("employee_id") @db.Uuid
  name           String   @db.VarChar(120)
  email          String   @unique @db.VarChar(255)
  passwordHash   String   @map("password_hash")
  role           UserRole
  isActive       Boolean  @default(true) @map("is_active")
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  organization        Organization?          @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  employee            Employee?              @relation(fields: [employeeId], references: [id], onDelete: SetNull)
  reviewedRequests    EmployeeRequest[]      @relation("EmployeeRequestReviewer")
  reviewedCorrections AttendanceCorrection[] @relation("AttendanceCorrectionReviewer")

  @@index([organizationId, role])
  @@index([role])
  @@map("users")
}

model Department {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  name           String   @db.VarChar(120)
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  employees    Employee[]

  @@unique([organizationId, name])
  @@index([organizationId])
  @@map("departments")
}

model Employee {
  id                      String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId          String    @map("organization_id") @db.Uuid
  departmentId            String?   @map("department_id") @db.Uuid
  employeeCode            String    @map("employee_code") @db.VarChar(60)
  name                    String    @db.VarChar(120)
  deviceUserId            String?   @map("device_user_id") @db.VarChar(80)
  isActive                Boolean   @default(true) @map("is_active")
  attendancePausedAt      DateTime? @map("attendance_paused_at") @db.Timestamptz(6)
  attendanceTrackingSince DateTime? @map("attendance_tracking_since") @db.Timestamptz(6)
  monthlySalary           Decimal   @default(0) @map("monthly_salary") @db.Decimal(12, 2)
  allowance               Decimal   @default(0) @map("allowance") @db.Decimal(12, 2)
  createdAt               DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt               DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  organization          Organization              @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  department            Department?               @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  user                  User?
  attendanceLogs        AttendanceLog[]
  dailyAttendances      DailyAttendance[]
  shiftAssignments      EmployeeShiftAssignment[]
  requests              EmployeeRequest[]
  attendanceCorrections AttendanceCorrection[]
  deductions Deduction[]

  @@unique([organizationId, employeeCode])
  @@unique([organizationId, deviceUserId])
  @@index([organizationId, departmentId])
  @@index([deviceUserId])
  @@map("employees")
}

model ZktecoDevice {
  id             String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String       @map("organization_id") @db.Uuid
  name           String       @db.VarChar(120)
  ip             String       @db.Inet
  port           Int          @default(4370)
  status         DeviceStatus @default(ACTIVE)
  lastSync       DateTime?    @map("last_sync") @db.Timestamptz(6)
  createdAt      DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime     @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  organization   Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  attendanceLogs AttendanceLog[]

  @@unique([organizationId, ip, port])
  @@index([organizationId, status])
  @@map("zkteco_devices")
}

model EmployeeRequest {
  id             String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String         @map("organization_id") @db.Uuid
  employeeId     String         @map("employee_id") @db.Uuid
  kind           RequestKind
  leaveCategory  LeaveCategory? @map("leave_category")
  fromDate       DateTime       @map("from_date") @db.Date
  toDate         DateTime       @map("to_date") @db.Date
  reason         String         @db.Text
  note           String?        @db.Text
  status         RequestStatus  @default(PENDING)
  submittedAt    DateTime       @default(now()) @map("submitted_at") @db.Timestamptz(6)
  updatedAt      DateTime       @updatedAt @map("updated_at") @db.Timestamptz(6)
  decidedAt      DateTime?      @map("decided_at") @db.Timestamptz(6)
  decidedBy      String?        @map("decided_by") @db.Uuid

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  employee     Employee     @relation(fields: [employeeId], references: [id], onDelete: Restrict)
  reviewer     User?        @relation("EmployeeRequestReviewer", fields: [decidedBy], references: [id])

  @@index([organizationId, status, submittedAt])
  @@index([employeeId, fromDate])
  @@map("employee_requests")
}

model AttendanceCorrection {
  id                String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId    String           @map("organization_id") @db.Uuid
  employeeId        String           @map("employee_id") @db.Uuid
  dailyAttendanceId String?          @map("daily_attendance_id") @db.Uuid
  complaintType     ComplaintType    @map("complaint_type")
  expectedCheckIn   DateTime?        @map("expected_check_in") @db.Time(6)
  expectedCheckOut  DateTime?        @map("expected_check_out") @db.Time(6)
  description       String           @db.Text
  status            CorrectionStatus @default(PENDING)
  submittedAt       DateTime         @default(now()) @map("submitted_at") @db.Timestamptz(6)
  updatedAt         DateTime         @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  decidedAt         DateTime?        @map("decided_at") @db.Timestamptz(6)
  decidedBy         String?          @map("decided_by") @db.Uuid

  organization    Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  employee        Employee         @relation(fields: [employeeId], references: [id], onDelete: Restrict)
  dailyAttendance DailyAttendance? @relation(fields: [dailyAttendanceId], references: [id], onDelete: SetNull)
  reviewer        User?            @relation("AttendanceCorrectionReviewer", fields: [decidedBy], references: [id], onDelete: SetNull)

  @@index([organizationId, status, submittedAt])
  @@index([employeeId, submittedAt])
  @@map("attendance_corrections")
}

model AttendanceLog {
  id                 String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId     String           @map("organization_id") @db.Uuid
  employeeId         String           @map("employee_id") @db.Uuid
  deviceId           String?          @map("device_id") @db.Uuid
  deviceNameSnapshot String?          @map("device_name_snapshot") @db.VarChar(120)
  punchTime          DateTime         @map("punch_time") @db.Timestamptz(6)
  verificationType   VerificationType @default(UNKNOWN) @map("verification_type")
  createdAt          DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)

  organization Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  employee     Employee      @relation(fields: [employeeId], references: [id], onDelete: Restrict)
  device       ZktecoDevice? @relation(fields: [deviceId], references: [id], onDelete: SetNull)

  @@unique([employeeId, deviceId, punchTime, verificationType], map: "attendance_logs_employee_device_punch_verification_key")
  @@index([punchTime])
  @@index([organizationId, punchTime])
  @@index([employeeId, punchTime])
  @@index([deviceId, punchTime])
  @@map("attendance_logs")
}

model DailyAttendance {
  id               String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId   String            @map("organization_id") @db.Uuid
  employeeId       String            @map("employee_id") @db.Uuid
  date             DateTime          @db.Date
  firstCheckIn     DateTime?         @map("first_check_in") @db.Timestamptz(6)
  lastCheckOut     DateTime?         @map("last_check_out") @db.Timestamptz(6)
  workingMinutes   Int               @default(0) @map("working_minutes")
  status           AttendanceStatus  @default(ABSENT)
  statusOverride   AttendanceStatus? @map("status_override")
  statusOverrideAt DateTime?         @map("status_override_at") @db.Timestamptz(6)
  statusOverrideBy String?           @map("status_override_by") @db.Uuid
  createdAt        DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime          @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  organization          Organization           @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  employee              Employee               @relation(fields: [employeeId], references: [id], onDelete: Restrict)
  shiftId               String?                @map("shift_id") @db.Uuid
  shift                 Shift?                 @relation(fields: [shiftId], references: [id], onDelete: SetNull)
  attendanceCorrections AttendanceCorrection[]
  shiftNameSnapshot     String?                @map("shift_name_snapshot") @db.VarChar(100)
  scheduledStart        DateTime?              @map("scheduled_start") @db.Timestamptz(6)
  scheduledEnd          DateTime?              @map("scheduled_end") @db.Timestamptz(6)
  graceDeadline         DateTime?              @map("grace_deadline") @db.Timestamptz(6)

  @@unique([employeeId, date])
  @@index([organizationId, date])
  @@index([organizationId, status, date])
  @@map("daily_attendance")
}

model Shift {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  name           String   @db.VarChar(100)
  startMinutes   Int      @map("start_minutes")
  endMinutes     Int      @map("end_minutes")
  isActive       Boolean  @default(true) @map("is_active")
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  organization     Organization              @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  assignments      EmployeeShiftAssignment[]
  dailyAttendances DailyAttendance[]

  @@unique([organizationId, name])
  @@index([organizationId, isActive])
  @@map("shifts")
}

model EmployeeShiftAssignment {
  id            String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  employeeId     String    @map("employee_id") @db.Uuid
  shiftId        String    @map("shift_id") @db.Uuid
  effectiveFrom  DateTime  @map("effective_from") @db.Date
  effectiveTo    DateTime? @map("effective_to") @db.Date
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  shift    Shift    @relation(fields: [shiftId], references: [id], onDelete: Restrict)

  @@index([employeeId, effectiveFrom, effectiveTo])
  @@index([shiftId])
  @@map("employee_shift_assignments")
}

model Deduction {
  id                       String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId           String    @map("organization_id") @db.Uuid
  employeeId               String    @map("employee_id") @db.Uuid
  payrollCycleMonth        String    @map("payroll_cycle_month") @db.VarChar(7)
  lateDays                 Int       @default(0) @map("late_days")
  halfDays                 Int       @default(0) @map("half_days")
  absentDays               Int       @default(0) @map("absent_days")
  lateHalfDayDeductionDays Int       @default(0) @map("late_half_day_deduction_days")
  totalDeductionDays       Int       @default(0) @map("total_deduction_days")
  monthlySalary            Decimal   @default(0) @map("monthly_salary") @db.Decimal(12, 2)
  payrollDays              Int       @default(0) @map("payroll_days")
  dailyRate                Decimal   @default(0) @map("daily_rate") @db.Decimal(12, 2)
  deductionAmount          Decimal   @default(0) @map("deduction_amount") @db.Decimal(12, 2)
  calculatedThrough        String?   @map("calculated_through") @db.VarChar(10)
  createdAt                DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt                DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  employee     Employee     @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@unique([employeeId, payrollCycleMonth])
  @@index([organizationId, payrollCycleMonth])
  @@map("deductions")
}
