generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  SUPER_ADMIN
  ORG_ADMIN
  HR_MANAGER
  EMPLOYEE
}

enum DeviceStatus {
  ACTIVE
  INACTIVE
  OFFLINE
  MAINTENANCE
}

enum VerificationType {
  FINGERPRINT
  PASSWORD
  CARD
  FACE
  MANUAL
  UNKNOWN
}

enum AttendanceStatus {
  PRESENT
  ABSENT
  LATE
  HALF_DAY
  MISSING_CHECKOUT
  ON_LEAVE
  HOLIDAY
  REMOTE
}

model Organization {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name      String   @db.VarChar(160)
  timezone  String   @default("UTC") @db.VarChar(80)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  users             User[]
  departments       Department[]
  employees         Employee[]
  zktecoDevices     ZktecoDevice[]
  attendanceLogs    AttendanceLog[]
  dailyAttendances  DailyAttendance[]

  @@index([name])
  @@map("organizations")
}

model User {
  id             String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String?   @map("organization_id") @db.Uuid
  employeeId     String?   @unique @map("employee_id") @db.Uuid
  name           String    @db.VarChar(120)
  email          String    @unique @db.VarChar(255)
  passwordHash   String    @map("password_hash")
  role           UserRole
  isActive       Boolean   @default(true) @map("is_active")
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  organization Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  employee     Employee?     @relation(fields: [employeeId], references: [id], onDelete: SetNull)

  @@index([organizationId, role])
  @@index([role])
  @@map("users")
}

model Department {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  name           String   @db.VarChar(120)
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  employees    Employee[]

  @@unique([organizationId, name])
  @@index([organizationId])
  @@map("departments")
}

model Employee {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  departmentId   String?  @map("department_id") @db.Uuid
  employeeCode   String   @map("employee_code") @db.VarChar(60)
  name           String   @db.VarChar(120)
  deviceUserId   String?  @map("device_user_id") @db.VarChar(80)
  isActive       Boolean  @default(true) @map("is_active")
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  organization     Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  department       Department?       @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  user             User?
  attendanceLogs   AttendanceLog[]
  dailyAttendances DailyAttendance[]

  @@unique([organizationId, employeeCode])
  @@unique([organizationId, deviceUserId])
  @@index([organizationId, departmentId])
  @@index([deviceUserId])
  @@map("employees")
}

model ZktecoDevice {
  id             String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String       @map("organization_id") @db.Uuid
  name           String       @db.VarChar(120)
  ip             String       @db.Inet
  port           Int          @default(4370)
  status         DeviceStatus @default(ACTIVE)
  lastSync       DateTime?    @map("last_sync") @db.Timestamptz(6)
  createdAt      DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime     @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  organization   Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  attendanceLogs AttendanceLog[]

  @@unique([organizationId, ip, port])
  @@index([organizationId, status])
  @@map("zkteco_devices")
}

model AttendanceLog {
  id               String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId   String           @map("organization_id") @db.Uuid
  employeeId       String           @map("employee_id") @db.Uuid
  deviceId         String           @map("device_id") @db.Uuid
  punchTime        DateTime         @map("punch_time") @db.Timestamptz(6)
  verificationType VerificationType @default(UNKNOWN) @map("verification_type")
  createdAt        DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  employee     Employee     @relation(fields: [employeeId], references: [id], onDelete: Restrict)
  device       ZktecoDevice @relation(fields: [deviceId], references: [id], onDelete: Restrict)

  @@unique([employeeId, deviceId, punchTime, verificationType], map: "attendance_logs_employee_device_punch_verification_key")
  @@index([organizationId, punchTime])
  @@index([employeeId, punchTime])
  @@index([deviceId, punchTime])
  @@map("attendance_logs")
}

model DailyAttendance {
  id             String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String           @map("organization_id") @db.Uuid
  employeeId     String           @map("employee_id") @db.Uuid
  date           DateTime         @db.Date
  firstCheckIn   DateTime?        @map("first_check_in") @db.Timestamptz(6)
  lastCheckOut   DateTime?        @map("last_check_out") @db.Timestamptz(6)
  workingMinutes Int              @default(0) @map("working_minutes")
  status         AttendanceStatus @default(ABSENT)
  statusOverride AttendanceStatus? @map("status_override")
  statusOverrideAt DateTime?       @map("status_override_at") @db.Timestamptz(6)
  statusOverrideBy String?         @map("status_override_by") @db.Uuid
  createdAt      DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime         @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  employee     Employee     @relation(fields: [employeeId], references: [id], onDelete: Restrict)

  @@unique([employeeId, date])
  @@index([organizationId, date])
  @@index([organizationId, status, date])
  @@map("daily_attendance")
}
